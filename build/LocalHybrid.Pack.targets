<Project>
  <!-- Imported after the original project, only by Build-LocalHybrid.ps1. -->
  <PropertyGroup>
    <PackageId>$(MSBuildProjectName.Replace('Wisej.Hybrid', 'Wisej-4-Hybrid').Replace('.', '-'))</PackageId>
    <PackageVersion>$(LocalHybridPackageVersion)</PackageVersion>
    <Version>$(LocalHybridPackageVersion)</Version>
    <Authors>Ice Tea Group LLC</Authors>
    <Description>Local source build of $(MSBuildProjectName).</Description>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>false</IncludeSymbols>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeCameraPreviewCompatibilityAssembly</TargetsForTfmSpecificBuildOutput>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net9.0-maccatalyst'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Update="Wisej-4" Version="4.1.4" />
    <PackageReference Update="Managed.System.Drawing" Version="4.1.4" />
    <PackageReference Update="Wisej-4-Hybrid*" Version="$(LocalHybridPackageVersion)" />
    <_LocalHybridProject Include="@(ProjectReference->WithMetadataValue('Filename', 'Wisej.Hybrid.Runtime'));@(ProjectReference->WithMetadataValue('Filename', 'Wisej.Hybrid.Scanning'))" />
    <ProjectReference Remove="@(_LocalHybridProject)" />
    <_LocalHybridProjectName Include="@(_LocalHybridProject->'%(Filename)')" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Wisej.Hybrid' And '$(TargetFramework)' == 'net48'">
    <!-- Match the release nuspec: net48 consumers use the framework HTTP assembly. -->
    <PackageReference Update="System.Net.Http" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="@(_LocalHybridProjectName->Replace('Wisej.Hybrid', 'Wisej-4-Hybrid')->Replace('.', '-'))" Version="$(LocalHybridPackageVersion)" />
    <None Include="$(MSBuildProjectDirectory)/Wisej.Hybrid.targets" Pack="true" PackagePath="build/Wisej-4-Hybrid.targets" Condition="'$(MSBuildProjectName)' == 'Wisej.Hybrid'" />
    <None Include="$(MSBuildProjectDirectory)/Wisej.Hybrid.Native.targets" Pack="true" PackagePath="build/Wisej-4-Hybrid-Native.targets" Condition="'$(MSBuildProjectName)' == 'Wisej.Hybrid.Native'" />
  </ItemGroup>
  <Target Name="IncludeCameraPreviewCompatibilityAssembly"
          Condition="'$(MSBuildProjectName)' == 'Wisej.Hybrid.MLKit.Native' And ('$(TargetFramework)' == 'net9.0-android' Or '$(TargetFramework)' == 'net9.0-ios')">
    <PropertyGroup><_CameraPreviewOutput>$(MSBuildProjectDirectory)/../../CameraPreview/Wisej.Hybrid.Native.CameraPreview/bin/$(Configuration)/$(TargetFramework)/Wisej.Hybrid.CameraPreview.Native.dll</_CameraPreviewOutput></PropertyGroup>
    <Error Condition="!Exists('$(_CameraPreviewOutput)')" Text="Build the CameraPreview compatibility assembly before packing MLKit." />
    <ItemGroup><BuildOutputInPackage Include="$(_CameraPreviewOutput)" /></ItemGroup>
  </Target>
</Project>
